# Azure AI Configuration
# Copy this file to .env and fill in your actual values

# Azure Tenant and Subscription
AZURE_TENANT_ID=your-tenant-id-here
AZURE_SUBSCRIPTION_ID=your-subscription-id-here

# Azure AI Project Endpoint
AZURE_AIPROJECT_ENDPOINT=https://your-endpoint.services.ai.azure.com/api/projects/your-project

# Azure Location
AZURE_LOCATION=your-location

# Agent Names
AGENT_RETAIL=retail-agent
AGENT_ORCHESTRATOR=buybuddy-orchestrator
AGENT_PRODUCT=product-agent
AGENT_INSURANCE=insurance-agent

# Optional: Resource IDs
AZURE_AIPROJECT_RESOURCE_ID=/subscriptions/xxx/resourceGroups/xxx/providers/Microsoft.CognitiveServices/accounts/xxx/projects/xxx
AZURE_RESOURCE_ID=/subscriptions/xxx/resourceGroups/xxx/providers/Microsoft.CognitiveServices/accounts/xxx

# (Optional) User‑assigned managed identity client id to use in App Service
# When deploying to App Service, attach the user-assigned identity to the Web App
# and set AZURE_MANAGED_IDENTITY_CLIENT_ID to its clientId so the app uses that identity.
AZURE_MANAGED_IDENTITY_CLIENT_ID=your-user-assigned-mi-client-id-here
